# Copia este archivo como .env y ajusta lo que necesites.

# docker-compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=myplaylist
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# Backend
ENV=local
EMAIL_BACKEND=smtp
DATA_POLICY_VERSION=0000-borrador
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/myplaylist
REDIS_URL=redis://localhost:6379/0
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_API_URL=http://localhost:8025

# Tiempo real (ADR-0014): el monolito y `realtime` comparten este secreto. El valor de
# desarrollo solo sirve en local; producción exige uno propio de al menos 32 caracteres.
REALTIME_TICKET_SECRET=solo-para-desarrollo-local-no-usar-en-produccion

# Catálogo de música (feature 003): el falso en local, sin clave. Con YouTube real, pon
# CATALOG_PROVIDER=youtube y una clave de la YouTube Data API v3 (no la versiones).
CATALOG_PROVIDER=fake
YOUTUBE_API_KEY=

# Firma de la cookie del dispositivo del cliente (feature 003). El valor de desarrollo
# solo sirve en local; producción exige uno propio de al menos 32 caracteres.
DEVICE_TOKEN_SECRET=solo-para-desarrollo-local-dispositivo-no-usar-en-produccion
